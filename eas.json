{
  "cli": {
    "version": ">= 7.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "APP_ENV": "homologation",
        "TEST_LICENSE_BYPASS": "true"
      }
    },
    "preview": {
      "android": {
        "buildType": "apk"
      },
      "env": {
        "APP_ENV": "homologation",
        "TEST_LICENSE_BYPASS": "true"
      }
    },
    "production": {
      "android": {
        "buildType": "apk"
      },
      "env": {
        "APP_ENV": "production",
        "TEST_LICENSE_BYPASS": "false"
      }
    }
  },
  "submit": {
    "production": {}
  }
}

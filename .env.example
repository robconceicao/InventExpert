# Copie este arquivo para .env e preencha com valores reais.
# NUNCA commite o arquivo .env com segredos.

# --- Supabase próprio do InventExpert (auth / gestão / escala) ---
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# --- Licenciamento comercial Tadeu Apps ---
# URL pública da loja/API de licenças.
EXPO_PUBLIC_TADEU_APPS_URL=https://tadeu-apps-core-test2.vercel.app
# Supabase da Tadeu Apps: usado somente para a sessão comercial/licença.
# A chave abaixo é pública/publishable; nunca use secret/service-role no aplicativo.
EXPO_PUBLIC_TADEU_APPS_SUPABASE_URL=https://YOUR_TADEU_APPS_PROJECT.supabase.co
EXPO_PUBLIC_TADEU_APPS_SUPABASE_ANON_KEY=your_tadeu_apps_publishable_key_here

# --- AI / OCR (client-side; preferir proxy server-side em produção) ---
GEMINI_API_KEY=sua_chave_gemini_aqui
DEEPSEEK_API_KEY=sua_chave_deepseek_aqui
GROQ_API_KEY=sua_chave_groq_aqui
OPENAI_API_KEY=sua_chave_openai_aqui

# --- Form cleaner API (opcional) ---
# EXPO_PUBLIC_FORM_CLEANER_URL=https://your-api.example.com/api/clean

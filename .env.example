# Copie este arquivo para .env e preencha com valores reais.
# NUNCA commite o arquivo .env com segredos.

# --- Supabase (obrigatório para auth / gestão / escala) ---
# Preferir EXPO_PUBLIC_* — lidos por app.config.js → expo.extra
# e também por process.env em runtime (Expo).
# A anon key só é segura se as policies RLS estiverem correctas
# (ver supabase/migration_rls_authenticated_only.sql).
# Após rotação de chaves, actualize aqui e em EAS Secrets.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# --- AI / OCR (client-side; preferir proxy server-side em produção) ---
GEMINI_API_KEY=sua_chave_gemini_aqui
DEEPSEEK_API_KEY=sua_chave_deepseek_aqui
GROQ_API_KEY=sua_chave_groq_aqui
OPENAI_API_KEY=sua_chave_openai_aqui

# --- Form cleaner API (opcional) ---
# EXPO_PUBLIC_FORM_CLEANER_URL=https://your-api.example.com/api/clean

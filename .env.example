# Copie este arquivo para .env e preencha com suas chaves reais
# NUNCA commite o arquivo .env com valores reais

# --- Supabase (obrigatório) ---
# O app.json não carrega mais credenciais: quem as fornece é o ambiente.
# Sem estas duas, o app sobe sem backend e a tela de login avisa.
#
# Build EAS — cadastre como secrets, uma vez por projeto:
#   eas secret:create --name EXPO_PUBLIC_SUPABASE_URL      --value https://<ref>.supabase.co
#   eas secret:create --name EXPO_PUBLIC_SUPABASE_ANON_KEY --value <anon key do painel>
#
# O <ref> e a anon key ficam em Supabase → Project Settings → API.
EXPO_PUBLIC_SUPABASE_URL=https://seu_projeto.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sua_chave_anon_aqui

# --- IA (opcional) ---
GEMINI_API_KEY=sua_chave_aqui
DEEPSEEK_API_KEY=sua_chave_deepseek_aqui
